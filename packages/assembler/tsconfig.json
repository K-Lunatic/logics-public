{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",                       // 👈 React JSX/Hook 인식 핵심!
    "lib": ["DOM", "DOM.Iterable", "ESNext"], // 👈 useEffect, window 등 브라우저 API 타입 인식
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
